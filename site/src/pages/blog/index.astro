---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buscarPostsBlog } from "../../lib/api";

let posts: Awaited<ReturnType<typeof buscarPostsBlog>> = [];
try {
  posts = await buscarPostsBlog();
} catch {
  posts = [];
}
---

<BaseLayout title="Blog" description="Conteúdo sobre gestão de pessoas e RH estratégico.">
  <section class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="text-3xl font-bold text-mhr-navy">Blog</h1>

    {posts.length === 0 && (
      <p class="mt-6 text-slate-600">Em breve, artigos sobre gestão de pessoas.</p>
    )}

    <div class="mt-8 flex flex-col gap-6">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="rounded border border-slate-200 p-6 hover:border-mhr-gold">
          {post.categoria && (
            <span class="text-xs font-semibold uppercase tracking-wide text-mhr-gold">{post.categoria}</span>
          )}
          <h2 class="mt-1 text-xl font-semibold text-mhr-navy">{post.titulo}</h2>
          <p class="mt-2 text-slate-600">{post.resumo}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
