---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buscarServicos, type Servico } from "../../lib/api";

// output: "static" -> rotas dinamicas precisam saber todos os paths em build time.
// Isso significa que um servico novo cadastrado no admin só aparece aqui depois de um
// novo build/deploy do site (aceitável por enquanto; documentado no README).
export async function getStaticPaths() {
  let servicos: Servico[] = [];
  try {
    servicos = await buscarServicos();
  } catch {
    servicos = [];
  }

  return servicos.map((servico) => ({
    params: { slug: servico.slug },
    props: { servico },
  }));
}

const { servico } = Astro.props as { servico: Servico };
---

<BaseLayout title={servico.titulo} description={servico.resumo}>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <a href="/servicos" class="text-sm text-mhr-gold hover:underline">&larr; Todos os serviços</a>
    <h1 class="mt-4 text-3xl font-bold text-mhr-navy">{servico.titulo}</h1>
    <p class="mt-4 whitespace-pre-line text-slate-700">{servico.conteudo}</p>

    <a href="/contato" class="botao-primario mt-8">
      Quero falar sobre esse serviço
    </a>
  </section>
</BaseLayout>
