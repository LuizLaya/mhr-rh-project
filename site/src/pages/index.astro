---
import BaseLayout from "../layouts/BaseLayout.astro";
import { buscarServicos, buscarDepoimentos, buscarClientesDestaque, buscarFaq } from "../lib/api";

let servicos: Awaited<ReturnType<typeof buscarServicos>> = [];
let depoimentos: Awaited<ReturnType<typeof buscarDepoimentos>> = [];
let clientesDestaque: Awaited<ReturnType<typeof buscarClientesDestaque>> = [];
let faq: Awaited<ReturnType<typeof buscarFaq>> = [];
try {
  servicos = await buscarServicos();
} catch {
  servicos = [];
}
try {
  depoimentos = await buscarDepoimentos();
} catch {
  depoimentos = [];
}
try {
  clientesDestaque = await buscarClientesDestaque();
} catch {
  clientesDestaque = [];
}
try {
  faq = await buscarFaq();
} catch {
  faq = [];
}
---

<BaseLayout
  title="RH estratégico para transformar pessoas e negócios"
  description="MHR: consultoria de RH, recrutamento e seleção, treinamento de lideranças e adequação à NR-01, em Brasília/DF."
>
  <section class="mx-auto max-w-6xl px-4 py-20 text-center">
    <h1 class="text-4xl font-bold text-mhr-navy md:text-5xl">
      Pessoas certas. <span class="text-mhr-gold">Resultados certos.</span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">
      A MHR transforma a gestão de pessoas da sua empresa com consultoria de RH,
      recrutamento e seleção, treinamento de lideranças e conformidade com a NR-01 —
      para o público em geral e para buscas específicas, de Brasília para todo o DF.
    </p>
    <a href="/contato" class="botao-primario mt-8">
      Fale com a gente
    </a>
  </section>

  {servicos.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-12">
      <h2 class="text-center text-2xl font-bold text-mhr-navy">O que fazemos</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {servicos.map((servico) => (
          <a href={`/servicos/${servico.slug}`} class="rounded border border-slate-200 p-5 hover:border-mhr-gold">
            <h3 class="font-semibold text-mhr-navy">{servico.titulo}</h3>
            <p class="mt-2 text-sm text-slate-600">{servico.resumo}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {depoimentos.length > 0 && (
    <section class="bg-slate-50 py-12">
      <div class="mx-auto max-w-4xl px-4">
        <h2 class="text-center text-2xl font-bold text-mhr-navy">Quem já confiou na MHR</h2>
        <div class="mt-8 flex flex-col gap-6">
          {depoimentos.map((depoimento) => (
            <blockquote class="rounded border border-slate-200 bg-white p-6">
              <p class="text-slate-700">"{depoimento.conteudo}"</p>
              <footer class="mt-3 text-sm font-medium text-mhr-navy">
                {depoimento.nomeAutor}
                {depoimento.nomeEmpresa && <span class="text-slate-500"> · {depoimento.nomeEmpresa}</span>}
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>
  )}

  {clientesDestaque.length > 0 && (
    <section class="mx-auto max-w-5xl px-4 py-12">
      <h2 class="text-center text-sm font-semibold uppercase tracking-wide text-slate-400">
        Empresas que já confiaram na MHR
      </h2>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
        {clientesDestaque.map((cliente) =>
          cliente.logoUrl ? (
            <div class="flex h-20 w-40 items-center justify-center rounded-lg border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md">
              <img src={cliente.logoUrl} alt={cliente.nomeEmpresa} class="max-h-12 w-auto max-w-full object-contain" />
            </div>
          ) : (
            <div class="flex h-20 w-40 items-center justify-center rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
              <span class="text-center text-sm font-medium text-slate-500">{cliente.nomeEmpresa}</span>
            </div>
          )
        )}
      </div>
    </section>
  )}

  {faq.length > 0 && (
    <section class="bg-slate-50 py-12">
      <div class="mx-auto max-w-3xl px-4">
        <h2 class="text-center text-2xl font-bold text-mhr-navy">Perguntas frequentes</h2>
        <div class="mt-8 flex flex-col gap-3">
          {faq.map((pergunta) => (
            <details class="group rounded-lg border border-slate-200 bg-white shadow-sm open:shadow-md">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 font-medium text-mhr-navy [&::-webkit-details-marker]:hidden">
                {pergunta.pergunta}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="h-5 w-5 flex-shrink-0 text-mhr-gold transition-transform duration-200 group-open:rotate-180"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <p class="border-t border-slate-100 px-4 pb-4 pt-3 text-sm text-slate-600">{pergunta.resposta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- TODO (Fase 3): contadores animados (anos de experiência, nº de clientes, vagas
       trabalhadas), quando houver dados reais para mostrar. -->
</BaseLayout>
