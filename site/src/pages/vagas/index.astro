---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buscarVagas } from "../../lib/api";

// SSG: a lista e buscada em build time. Para refletir vagas novas sem rebuild completo,
// avaliar output "server"/ISR mais adiante, ou rebuild automatico via webhook do admin.
let vagas: Awaited<ReturnType<typeof buscarVagas>> = [];
try {
  vagas = await buscarVagas();
} catch {
  vagas = [];
}
---

<BaseLayout title="Vagas" description="Vagas abertas trabalhadas pela MHR.">
  <section class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="text-3xl font-bold text-mhr-navy">Vagas abertas</h1>

    {vagas.length === 0 && (
      <p class="mt-6 text-slate-600">Nenhuma vaga aberta no momento. Volte em breve!</p>
    )}

    <ul class="mt-8 flex flex-col gap-4">
      {vagas.map((vaga) => (
        <li class="rounded border border-slate-200 p-5">
          <a href={`/vagas/${vaga.slug}`} class="text-lg font-semibold text-mhr-navy hover:text-mhr-gold">
            {vaga.titulo}
          </a>
          <p class="text-sm text-slate-500">{vaga.cidade} · {vaga.modeloTrabalho}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
