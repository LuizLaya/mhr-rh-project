---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CandidaturaForm from "../../components/react/CandidaturaForm";
import { buscarVagas, type Vaga } from "../../lib/api";

// output: "static" -> rotas dinamicas precisam saber todos os paths em build time
// (mesmo padrao de site/src/pages/servicos/[slug].astro). Uma vaga nova só aparece
// aqui depois de um novo build/deploy do site.
export async function getStaticPaths() {
  let vagas: Vaga[] = [];
  try {
    vagas = await buscarVagas();
  } catch {
    vagas = [];
  }

  return vagas.map((vaga) => ({
    params: { slug: vaga.slug },
    props: { vaga },
  }));
}

const { vaga } = Astro.props as { vaga: Vaga };

const MODELO_TRABALHO_LABEL: Record<Vaga["modeloTrabalho"], string> = {
  PRESENCIAL: "Presencial",
  HIBRIDO: "Híbrido",
  REMOTO: "Remoto",
};
---

<BaseLayout title={vaga.titulo} description={`Vaga de ${vaga.titulo} em ${vaga.cidade}.`}>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <a href="/vagas" class="text-sm text-mhr-gold hover:underline">&larr; Todas as vagas</a>
    <h1 class="mt-4 text-3xl font-bold text-mhr-navy">{vaga.titulo}</h1>
    <p class="mt-1 text-sm text-slate-500">{vaga.cidade} · {MODELO_TRABALHO_LABEL[vaga.modeloTrabalho]}</p>
    <p class="mt-6 whitespace-pre-line text-slate-700">{vaga.descricao}</p>

    {vaga.status === "ABERTA" ? (
      <div class="mt-10 border-t border-slate-200 pt-8">
        <h2 class="text-xl font-semibold text-mhr-navy">Candidate-se</h2>
        <div class="mt-4">
          <CandidaturaForm vagaId={vaga.id} client:load />
        </div>
      </div>
    ) : (
      <p class="mt-10 rounded border border-slate-200 bg-slate-50 p-4 text-sm text-slate-500">
        Esta vaga não está mais recebendo candidaturas.
      </p>
    )}
  </section>
</BaseLayout>
