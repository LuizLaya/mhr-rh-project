---
import { buscarVagas, buscarPostsBlog } from "../lib/api";

// Busca vagas/posts em build time só pra decidir se mostra o link no menu - se não
// há nenhum publicado, o link some (pedido explícito: não mostrar uma seção vazia).
let temVagas = false;
let temBlog = false;
try {
  temVagas = (await buscarVagas()).length > 0;
} catch {
  temVagas = false;
}
try {
  temBlog = (await buscarPostsBlog()).length > 0;
} catch {
  temBlog = false;
}

const links = [
  { href: "/", label: "Home" },
  { href: "/sobre", label: "Sobre" },
  { href: "/servicos", label: "Serviços" },
  ...(temVagas ? [{ href: "/vagas", label: "Vagas" }] : []),
  ...(temBlog ? [{ href: "/blog", label: "Blog" }] : []),
  { href: "/contato", label: "Contato" },
];
---

<header class="sticky top-0 z-40 border-b border-slate-100 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
    <a href="/" class="flex items-center gap-2">
      <img src="/brand/logo-dark.png" alt="MHR" class="h-10 w-auto" />
    </a>

    <nav class="hidden gap-6 md:flex">
      {links.map((link) => (
        <a href={link.href} class="text-sm font-medium text-mhr-navy transition hover:text-mhr-gold">
          {link.label}
        </a>
      ))}
    </nav>

    <details class="relative md:hidden">
      <summary class="list-none cursor-pointer rounded p-2 text-mhr-navy hover:bg-slate-100 [&::-webkit-details-marker]:hidden">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>
      <nav class="absolute right-0 mt-2 flex w-48 flex-col gap-1 rounded border border-slate-200 bg-white p-3 shadow-lg">
        {links.map((link) => (
          <a href={link.href} class="rounded px-3 py-2 text-sm font-medium text-mhr-navy hover:bg-slate-50">
            {link.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
