# Referência das variáveis de ambiente lidas em application.yml.
# Spring Boot não carrega .env automaticamente: exporte essas variáveis no shell,
# no docker-compose do deploy, ou no painel do provedor de hospedagem.

DB_URL=jdbc:postgresql://localhost:5432/mhr
DB_USER=mhr
DB_PASSWORD=mhr
JWT_SECRET=change-me-generate-a-long-random-value
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:5173
PORT=8080
ADMIN_EMAIL=admin@mhr.com.br
ADMIN_PASSWORD=troque-essa-senha

# "Esqueci minha senha" e "convidar usuario": sem essas variaveis, o link so vai
# para o log do backend (nao envia e-mail de verdade).
#
# Provedor usado hoje: Resend (resend.com) - plano gratis, sem exigir senha de
# app nem 2FA como o Gmail. Usuario SMTP do Resend e sempre a palavra "resend";
# a senha e a API key gerada em resend.com/api-keys.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
# Remetente exibido no "De". Sem dominio verificado no Resend (resend.com/domains),
# so e possivel enviar usando onboarding@resend.dev como remetente, e so para o
# proprio e-mail da conta Resend (modo sandbox). Apos verificar um dominio da MHR,
# trocar para um endereco proprio (ex.: convites@mhr.com.br).
MAIL_FROM=onboarding@resend.dev
FRONTEND_ADMIN_URL=http://localhost:5173

# Busca automatica de licitacoes no PNCP (so roda quando ligada pelo admin na
# tela Licitacoes). As palavras-chave sao editaveis na propria tela, nao ficam
# mais aqui.
LICITACOES_UFS=DF

# Anti-spam (Cloudflare Turnstile) nos formularios publicos de contato e
# candidatura. Chave secreta de teste da Cloudflare (sempre aprova, nao precisa
# de conta) - troque por uma chave real (dashboard da Cloudflare > Turnstile)
# antes de producao, em par com PUBLIC_TURNSTILE_SITE_KEY no site.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Upload de imagens (foto de depoimento, capa de post, logo de cliente) num
# storage de objeto (Cloudflare R2, compativel com a API do S3) - sobrevive a um
# redeploy, ao contrario de disco local. Sem as 4 variaveis abaixo, o
# UploadService cai de volta pro disco local automaticamente (bom o bastante
# para desenvolvimento). Criar o bucket em dash.cloudflare.com > R2, gerar as
# chaves de API em "Manage R2 API Tokens", e ativar acesso publico ao bucket
# (ou um dominio customizado) para preencher R2_PUBLIC_URL.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Endpoint da API (gestao do bucket), formato https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# URL publica de LEITURA (dominio pub-xxxx.r2.dev padrao, ou um dominio customizado) -
# diferente do R2_ENDPOINT acima, que nao e navegavel publicamente.
R2_PUBLIC_URL=
